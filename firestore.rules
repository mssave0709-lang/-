rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidPortfolioItem(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.clientOrStore is string && data.clientOrStore.size() <= 100 &&
             data.category is string && data.category.size() <= 50;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Portfolio Items: Publicly readable and writable by site manager
    match /portfolio_items/{itemId} {
      allow get, list: if true;
      allow create, update: if isValidId(itemId) && isValidPortfolioItem(request.resource.data);
      allow delete: if isValidId(itemId);
    }

    // Categories & Settings: Publicly readable and writable
    match /settings/{docId} {
      allow read, write: if true;
    }

    match /categories/{categoryId} {
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}

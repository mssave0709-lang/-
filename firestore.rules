rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'mssave0709@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidPortfolioItem(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.clientOrStore is string && data.clientOrStore.size() <= 100 &&
             data.category is string && data.category.size() <= 50 &&
             data.summary is string && data.summary.size() <= 1000;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins collection
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Portfolio Items: Publicly readable, authenticated admin can manage
    match /portfolio_items/{itemId} {
      allow get, list: if true;
      allow create: if (isAdmin() || isSignedIn()) && isValidId(itemId) && isValidPortfolioItem(request.resource.data);
      allow update: if (isAdmin() || isSignedIn()) && isValidId(itemId) && isValidPortfolioItem(request.resource.data);
      allow delete: if (isAdmin() || isSignedIn()) && isValidId(itemId);
    }

    // Categories
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update: if (isAdmin() || isSignedIn()) && isValidId(categoryId);
      allow delete: if (isAdmin() || isSignedIn()) && isValidId(categoryId);
    }
  }
}
